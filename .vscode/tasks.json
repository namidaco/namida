{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "flutter",
      "command": "flutter",
      "args": ["build", "apk"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "label": "flutter: flutter build apk",
      "detail": ""
    },
    {
      "type": "flutter",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--target-platform",
        "android-arm64",
        "--release",
        "--dart-define=IS_KURU_BUILD=true"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "label": "build flutter apk arm64",
      "detail": ""
    },
    {
      "type": "flutter",
      "command": "flutter",
      "args": ["run", "-d", "windows"],
      "group": {
        "kind": "none"
      },
      "problemMatcher": [],
      "label": "flutter run windows",
      "detail": ""
    },
    {
      "type": "shell",
      "command": "git",
      "args": ["submodule", "update", "--init", "--remote", "--recursive"],
      "group": {
        "kind": "none",
        "isDefault": false
      },
      "problemMatcher": [],
      "label": "update submodules",
      "detail": ""
    },
    {
      "type": "flutter",
      "command": "flutter",
      "args": ["build", "windows", "--release"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "label": "flutter build windows",
      "detail": ""
    },
    {
      "type": "flutter",
      "command": "flutter",
      "args": [
        "build",
        "windows",
        "--release",
        "--dart-define=IS_KURU_BUILD=true"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "label": "flutter build windows kuru",
      "detail": ""
    },
    {
      "type": "dart",
      "command": "dart",
      "args": ["run", "inno_bundle:build", "--release", "--no-app"],
      "group": {
        "kind": "build"
      },
      "dependsOn": ["flutter build windows"],
      "problemMatcher": [],
      "label": "build flutter windows inno installer",
      "detail": ""
    },
    {
      "type": "dart",
      "command": "dart",
      "args": ["run", "inno_bundle:build", "--release", "--no-app"],
      "dependsOn": ["flutter build windows kuru"],
      "group": {
        "kind": "build"
      },
      "problemMatcher": [],
      "label": "build flutter windows inno installer kuru",
      "detail": ""
    },
    {
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$apk = Get-ChildItem -Path '${workspaceFolder}\\build\\app\\outputs\\apk\\release\\*arm64*.apk' | Select-Object -First 1; $connected = (adb devices | Select-Object -Skip 1 | Where-Object { $_ -match 'device' } | ForEach-Object { $_.Trim().Split()[0] }); Write-Host \"Connected: $connected\"; @('55t445caskvcai5x','5c12eba1') | Where-Object { $connected -contains $_ } | ForEach-Object { Write-Host \"Pushing to $_\"; adb -s $_ push $apk.FullName /sdcard/ }"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "label": "Push arm64 APK to device",
      "detail": ""
    },
    {
      "type": "shell",
      "command": "python",
      "args": ["scripts/chlog.py", "group", "list"],
      "group": { "kind": "none" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "label": "chlog: list groups",
      "detail": "groups, conflicts and files no group claims yet"
    },
    {
      "type": "shell",
      "command": "python",
      "args": ["scripts/chlog.py", "group", "add", "${input:chlogGroup}", "${relativeFile}"],
      "group": { "kind": "none" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "label": "chlog: add current file to group",
      "detail": "adds the focused editor's file to a group"
    },
    {
      "type": "shell",
      "command": "python",
      "args": ["scripts/chlog.py", "group", "add", "${input:chlogGroup}", "--unassigned"],
      "group": { "kind": "none" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "label": "chlog: sweep unassigned into group",
      "detail": "takes every changed file no group claims yet"
    },
    {
      "type": "shell",
      "command": "python",
      "args": ["scripts/chlog.py", "group", "hunks", "${relativeFile}"],
      "group": { "kind": "none" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "label": "chlog: hunks of current file",
      "detail": "numbered hunks, to add them as path:1,3"
    },
    {
      "type": "shell",
      "command": "python",
      "args": ["scripts/chlog.py", "group", "show", "${input:chlogGroup}"],
      "group": { "kind": "none" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "label": "chlog: show group diff",
      "detail": "exactly what that group would commit"
    },
    {
      "type": "shell",
      "command": "python",
      "args": ["scripts/chlog.py", "group", "commit", "${input:chlogGroup}"],
      "group": { "kind": "none" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "label": "chlog: commit group",
      "detail": "commits only that group, opens the editor with the template"
    }
  ],
  "inputs": [
    {
      "id": "is_kuru",
      "type": "pickString",
      "description": "for kuru?",
      "options": ["true", "false"],
      "default": "false"
    },
    {
      "id": "chlogGroup",
      "type": "promptString",
      "description": "group name"
    }
  ]
}
